{
  "name": "kairos-journal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal trading journal with analytics and daily rule lock (independent implementation)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test \"shared/*.test.js\" \"server/*.test.js\""
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "multer": "^2.5.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "vite": "^8.3.6"
  }
}
